# Copy to .env for local use (never commit .env). On Netlify, set these under
# Site configuration -> Environment variables.
#
# Everything here is OPTIONAL. With no variables at all the app works fully,
# storing your data in this browser only.

# --- Optional: Firebase sync (Google sign-in + Firestore) --------------------
# Console -> Project settings -> Your apps -> Web app -> SDK config.
# These identify your project; they are not secrets (Firestore rules protect data).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=

# --- Optional: keep strangers off your function quota ------------------------
# When true, /api/* requires a Firebase sign-in (Firebase vars above are needed).
REQUIRE_AUTH=false
# Comma-separated Google accounts allowed in (empty = any signed-in user).
ALLOWED_EMAILS=

# --- Optional: politeness for publishers --------------------------------------
# Shown in the User-Agent so site owners can contact you. e.g. https://your-site.netlify.app
CONTACT_URL=
# USER_AGENT=
